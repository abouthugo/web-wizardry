---
import MainLayout from "../layouts/MainLayout.astro";
import GithubLogo from "../images/github.svg";
import EmailLogo from "../images/email.svg";
import LinkedInLogo from "../images/linkedin.svg";
---

<MainLayout>
  <div class="flex h-screen items-center justify-center">
    <section class="flex flex-col gap-8 text-center">
      <h1 class="text-4xl font-bold">Hugo Perdomo</h1>
      <ul class="flex justify-center gap-4">
        <li class="flex items-center justify-center gap-2">
          <a href="mailto:him@hugoperdomo.com">
            <EmailLogo width={24} height={24} />
          </a>
        </li>
        <li class="flex items-center justify-center gap-2">
          <a href="https://github.com/abouthugo">
            <GithubLogo fill="red" width={24} height={24} />
          </a>
        </li>
        <li class="flex items-center justify-center gap-2">
          <a href="https://www.linkedin.com/in/hugoperdomo/">
            <LinkedInLogo fill="red" width={24} height={24} />
          </a>
        </li>
      </ul>
    </section>
  </div>
</MainLayout>
