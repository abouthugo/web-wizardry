---
import MainLayout from "../layouts/MainLayout.astro";
import { Content as AboutContent } from "../writing/about.md";
import cn from "../utils/cn";

const baseStyles = [
  // layout specific
  "flex flex-col gap-5",

  // handles the text
  "font-iawriter text-lg leading-[1.78] text-gray-300 md:text-base md:leading-[1.75]",

  // handles the anchor tags
  "[&_a]:text-green-200 [&_a]:decoration-green-400 [&_a]:underline [&_a]:underline-offset-[3px]",
];
---

<MainLayout>
  <section class:list={cn(baseStyles)}>
    <AboutContent />
  </section>
</MainLayout>
