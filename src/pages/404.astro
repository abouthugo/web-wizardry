---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Page Not Found">
  <div class="flex h-96 items-center justify-center">
    <section class="flex flex-col gap-2 text-center">
      <h1 class="text-5xl font-bold text-emerald-50">🔮 404</h1>
      <h2 class="text-lg text-balance text-emerald-50">
        Check your url because this page is nowhere to be found
      </h2>
      <a href="/" class="text-green-400"> &leftarrow; Go back home</a>
    </section>
  </div>
</MainLayout>
