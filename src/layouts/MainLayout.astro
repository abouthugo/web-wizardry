---
import "../styles/global.css";
import Head from "../components/Head.astro";

interface Props {
  title?: string;
}
const { title = "Hugo Perdomo" } = Astro.props;
---

<html>
  <head>
    <meta charset="utf-8" />
    <Head title={title} />
  </head>
  <body class="mx-auto max-w-2xl">
    <slot />
  </body>
</html>
