---
import Link from "./Link.astro";

interface LinkItem {
  uri: string;
  title: string;
}

interface Props {
  title?: string;
  list: LinkItem[];
}

const { title, list } = Astro.props;
---

<section class="flex w-sm flex-col gap-2 rounded-2xl">
  <h2 class="text-lg font-bold">{title}</h2>
  <ul class="flex flex-col gap-2">
    {
      list.map((link) => (
        <li class="flex">
          <Link href={link.uri}>{link.title} &UpperRightArrow;</Link>
        </li>
      ))
    }
  </ul>
</section>
